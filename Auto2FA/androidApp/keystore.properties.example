# Copy this to keystore.properties (gitignored) after generating your own release keystore:
#
#   keytool -genkeypair -v -keystore release.keystore -alias auto2fa \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
#
# (PKCS12 keystores require the store and key passwords to match -- keytool will prompt for
# both, just answer the same value each time.) Without this file, `assembleRelease` still
# works but produces an unsigned APK.

storeFile=release.keystore
storePassword=changeit
keyAlias=auto2fa
keyPassword=changeit
